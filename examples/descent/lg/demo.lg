;; demo.lg — a scripted descent-and-fight arc, as data.
;;
;; Exists so the tension model can be heard rather than only asserted. The
;; host walks this vector one entry per "turn", asks music.lg for the target,
;; runs the envelope, pushes the result at the engine — and hands the turn's
;; events to sfx.lg, which is exactly the flow xsofy will have, with the world
;; coming from the game instead of from a literal here.
;;
;; Events follow the taste call the design made explicit: the player's own
;; footstep sounds on every turn taken (quiet by design), so a walking turn is
;; [{:kind :footstep}] and a turn spent being hit or resting has no step.

(ns demo
  (:require [music]
            [sfx]))

(def ^:private full {:hp 20 :max-hp 20})

(defn- world
  "A world at a given hp with n engaged hostiles in view."
  [depth hp n]
  (let [poss (map (fn [i] [i i]) (range n))
        ids  (map (fn [i] (keyword (str "m" i))) (range n))]
    {:seed-input 42
     :depth depth
     :fov (set poss)
     :entities (merge {:player {:id :player :body {:hp hp :max-hp 20}}}
                      (zipmap ids (map (fn [id pos] {:id id :ai {:state :hunt} :pos pos})
                                       ids poss)))}))

(def ^:private step [{:kind :footstep}])

;; [label world events] per turn. The shape of the arc is the point: a long
;; quiet stretch, an ambush, a fight that costs real hp, a rune pried from the
;; ashes, then a recovery that is audibly slower than the ambush was sudden.
;; Hits land every two or three turns, with circling turns between: back to
;; back they blurred into one noise, and the page counts each one in.
(def arc
  [["descending, quiet"        (world 3 20 0) step]
   ["quiet"                    (world 3 20 0) step]
   ["quiet"                    (world 3 20 0) step]
   ["a shape in the dark"      (world 3 20 1) [{:kind :footstep}
                                               {:kind :footstep :dist 6 :dir -0.7}]]
   ["it has seen you"          (world 3 20 2) [{:kind :footstep :dist 4 :dir -0.5}]]
   ["it closes in"             (world 3 20 2) [{:kind :footstep :dist 2 :dir -0.3}]]
   ["struck — 15/20"           (world 3 15 2) [{:kind :combat-hit}]]
   ["circling"                 (world 3 15 2) step]
   ["struck again — 9/20"      (world 3  9 2) [{:kind :combat-hit}]]
   ["three of them now"        (world 3  9 3) [{:kind :footstep :dist 3 :dir 0.6}]]
   ["circling"                 (world 3  9 3) step]
   ["badly hurt — 4/20"        (world 3  4 3) [{:kind :combat-hit}]]
   ["bracing"                  (world 3  4 3) []]
   ["one down"                 (world 3  4 2) [{:kind :combat-hit :dist 1 :dir 0.4}]]
   ["circling"                 (world 3  4 2) step]
   ["another down"             (world 3  4 1) [{:kind :combat-hit :dist 1 :dir -0.3}]]
   ["last one flees"           (world 3  4 0) [{:kind :footstep :dist 5 :dir 0.8}]]
   ["a rune in the ashes"      (world 3  4 0) [{:kind :footstep} {:kind :pickup}]]
   ["alone, still bleeding"    (world 3  4 0) step]
   ["resting"                  (world 3  7 0) []]
   ["resting"                  (world 3 11 0) []]
   ["resting"                  (world 3 15 0) []]
   ["mended"                   (world 3 20 0) step]
   ["quiet again"              (world 3 20 0) step]
   ["descending to 5"          (world 5 20 0) step]
   ["the deep, quiet"          (world 5 20 0) step]])

(defn label [i] (first (nth arc i)))
(defn world-at [i] (second (nth arc i)))
(defn events-at [i] (nth (nth arc i) 2))
(defn turns [] (count arc))

(defn hit?
  "Whether turn i lands a blow, so a page can count it in."
  [i]
  (boolean (some (fn [e] (= :combat-hit (:kind e))) (events-at i))))

(defn cue
  "The turn's events as a short trace tag, so the printed arc shows what
  fired without the reader decoding descriptor maps."
  [i]
  (let [names {:footstep "step" :combat-hit "hit!" :pickup "rune!"}]
    (apply str (interpose "+" (map (fn [e] (get names (:kind e) "?"))
                                   (events-at i))))))

(defn triggers
  "The turn's trigger maps — the exact value the host hands to undertone/trigger."
  [i]
  (sfx/for-events (world-at i) i (events-at i)))
